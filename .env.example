# Server-only: the real upstream Laravel API. Used for SSR/RSC fetches and
# as the destination for the /api/v1 and /api/proxy rewrites in next.config.ts.
API_BASE_URL=https://api.globaluntoldstory.com/api/v1

# Leave NEXT_PUBLIC_API_BASE_URL unset in normal deployments. When unset,
# the browser calls same-origin /api/v1 (proxied server-side to API_BASE_URL
# above), which avoids CORS issues. Only set this if you intentionally want
# the browser to call the upstream API directly (requires CORS to be
# configured on the API for this site's origin).
# NEXT_PUBLIC_API_BASE_URL=https://api.globaluntoldstory.com/api/v1

NEXT_PUBLIC_API_LOCALE=en
