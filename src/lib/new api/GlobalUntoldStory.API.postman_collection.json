		{
			"name": "Admin",
			"description": "Admin JSON API. Login first, then use the Bearer token (auto-saved to `adminToken` by the Login request test script).",
			"auth": {
				"type": "bearer",
				"bearer": [
					{
						"key": "token",
						"value": "{{adminToken}}",
						"type": "string"
					}
				]
			},
			"item": [
				{
					"name": "Auth",
					"item": [
						{
							"name": "Login",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"if (pm.response.code === 200) {",
											"    const json = pm.response.json();",
											"    const token = json.token || json.data?.token || json.access_token;",
											"    if (token) {",
											"        pm.collectionVariables.set('adminToken', token);",
											"        pm.environment.set('adminToken', token);",
											"    }",
											"}"
										],
										"type": "text/javascript"
									}
								}
							],
							"request": {
								"auth": {
									"type": "noauth"
								},
								"method": "POST",
								"header": [
									{
										"key": "Accept",
										"value": "application/json"
									},
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/admin/login",
									"host": ["{{baseUrl}}"],
									"path": ["admin", "login"]
								},
								"description": "Admin login. Returns Sanctum token + user.\n\nRequires role: super-admin, admin, editor, or viewer.\n\nOn success, the test script saves the token to `adminToken`."
							}
						},
						{
							"name": "Logout",
