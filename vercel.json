{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.globaluntoldstory.com" }],
      "destination": "https://globaluntoldstory.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    { "path": "/api/cron/rebuild", "schedule": "0 * * * *" }
  ]
}
